{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/themes/ascii/asciiart10.txt",
    "padding": {
      "top": 1,
      "left": 0,
      "right": 1
    }
  },
  "display": {
    "separator": " "
  },
  "modules": [
    {
      "key": "┏━━━━━━━━┓",
      "type": "custom"
    },
    // {
    //   "key": "┃ {#31} USR  {#keys}┃",
    //   "type": "title",
    //   "format": "{user-name}"
    // },
    {
      "key": "┃ {#34}{icon} Os   {#keys}┃",
      "type": "os",
      "format": "Fedora"
    },
    {
      "key": "┃ {#35} ker  {#keys}┃",
      // "type": "kernel",
      // "format": "{release}"
      "type": "command",
      "text": "uname -r | cut -d'-' -f1"
    },
    {
      "key": "┃ {#36}󰧨 wm   {#keys}┃",
      "type": "wm",
      "format": "{1}"      
    },
    {
     "key": "┃ {#31} term {#keys}┃",
     "type": "terminal",
     "format": "{1}" 
    },
    {
      "key": "┃ {#31}󱆃 Shll {#keys}┃",
      "type": "shell",
      "format": "{1}" 
    },
    // {
    //   "key": "┃ {#34}󰉉 disk {#keys}┃",
    //   "type": "disk",
    //   "folders": "/",
    //   "format": "{1} / {2} ({3})"
    // },
    {
      "key": "┃ {#33}󰅐 Up   {#keys}┃",
      "type": "uptime"
    },
    {
      "key": "┃ {#36}󰍛 mem  {#keys}┃",
      "type": "memory",
      "percent": {"type": 8}
    },
    // {
    //   "key": "┃ {#99}󰏖 pkg  {#keys}┃",
    //   "type": "packages",
    //   "format": "{rpm} rpm, {flatpak-system} flatpak",
    // },
    // {
    //   "key": "┣━━━━━━━━┫",
    //   "type": "custom",
    // },
    // {
    //   "key": "┃ {#39} clrs {#keys}┃",
    //   "type": "colors",
    //   "symbol": "circle",
    // },
    {
      "key": "┗━━━━━━━━┛",
      "type": "custom"
    }
  ]
}
