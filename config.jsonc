{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/themes/ascii/asciiart10.txt",
    "padding": {
      "top": 1,
      "left": 0,
      "right": 1
    },
    "color": {
      "1": "#63ffff",
      "2": "#63c6c6"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#ffffff",
      "title": "#c6c6c6"
    },
    "percent": {
      "color": {
        "green": "#e2e2e2",
        "yellow": "#474747",
        "red": "#ffb4ab"
      }
    }
  },
  "modules": [
    {
      "key": "┏━━━━━━━━┓",
      "type": "custom"
    },
    {
      "key": "┃ {#34} Os   {#keys}┃",
      "type": "os",
      "format": "Fedora minimal 44"
    },
    {
      "key": "┃ {#35} ker  {#keys}┃",
      "type": "command",
      "text": "uname -r | cut -d'-' -f1"
    },
    {
      "key": "┃ {#36} wm   {#keys}┃",
      "type": "wm",
      "format": "{1}"
    },
    {
      "key": "┃ {#31} term {#keys}┃",
      "type": "terminal",
      "format": "{1}"
    },
    {
      "key": "┃ {#31} shll {#keys}┃",
      "type": "shell",
      "format": "{1}"
    },
    {
      "key": "┃ {#33}󰞌 up   {#keys}┃",
      "type": "uptime"
    },
    {
      "key": "┃ {#32} Age  {#keys}┃",
      "type": "command",
      "text": "echo $(( ($(date +%s) - $(stat -c %W / 2>/dev/null || stat -c %Y /)) / 86400 )) days"
    },
    {
      "key": "┃ {#36}󰟜 mem  {#keys}┃",
      "type": "memory",
      "percent": {
        "type": 8
      }
    },
    {
      "key": "┗━━━━━━━━┛",
      "type": "custom"
    }
  ]
}
